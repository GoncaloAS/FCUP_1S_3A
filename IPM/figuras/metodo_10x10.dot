digraph m10x10 {
  rankdir=TB; nodesep=0.35; ranksep=0.3;
  node [shape=box, style="rounded,filled", fillcolor="#e8eef7", color="#1f3864", fontname="Helvetica", fontsize=11, width=4.6, margin="0.2,0.08"];
  edge [color="#1f3864", fontname="Helvetica", fontsize=9];
  S1 [label="1. Enunciar o desafio de desenho"];
  S2 [label="2. EXPANDIR: gerar ≥ 10 conceitos diferentes", fillcolor="#e9f7ef", color="#1E7A46"];
  S3 [label="3. REDUZIR: rever, descartar, pedir feedback", fillcolor="#fdf2e3", color="#B9770E"];
