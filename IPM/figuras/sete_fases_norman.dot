digraph sete_fases {
  rankdir=TB; nodesep=0.4; ranksep=0.12;
  node [shape=box, style="rounded,filled", fillcolor="#e8eef7", color="#1f3864", fontname="Helvetica", fontsize=13, margin="0.1,0.03", width=2.2];
  edge [color="#1f3864", arrowsize=0.7];

  F1 [label="1  Objetivo\n\"o que quero fazer?\"", fillcolor="#fff2cc"];
  F2 [label="2  Intenção\n\"acho que se faz assim. Como?\""];
  F3 [label="3  Sequência de ações\n\"faço isto, depois isto...\""];
  F4 [label="4  Execução\n(a mão mexe-se)"];
  F5 [label="5  Perceção\n\"o que estou a ver agora?\""];
  F6 [label="6  Interpretação\n\"o que fez o sistema?\""];
  F7 [label="7  Avaliação\n\"era isto que eu queria?\""];
  M  [label="O mundo (o sistema)", fillcolor="#e2efda", width=4.7];

  {rank=same; F2; F7}
  {rank=same; F3; F6}
  {rank=same; F4; F5}
  F1 -> F2; F2 -> F3; F3 -> F4; F4 -> M;
  M -> F5; F5 -> F6; F6 -> F7; F7 -> F1 [constraint=false];
  F2 -> F7 [style=invis]; F3 -> F6 [style=invis];
}
