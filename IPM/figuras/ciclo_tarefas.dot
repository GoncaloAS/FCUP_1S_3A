digraph ciclo_tarefas {
  rankdir=LR;
  node [shape=box, style="rounded,filled", fillcolor="#e8eef7", color="#1f3864", fontname="Helvetica", fontsize=12, margin="0.25,0.15"];
  edge [color="#1f3864", fontname="Helvetica", fontsize=10];

  T1 [label="T1\nIdentificar utilizadores\ne stakeholders"];
  T2 [label="T2\nEstudos iniciais\n(utilizador, tecnologia,\nobjetivos)"];
  T3 [label="T3\nDesenho conceptual"];
  T4 [label="T4\nAvaliação"];

  T1 -> T2 -> T3 -> T4;
  T4 -> T3 [label="  o que se aprendeu\n  na avaliação", constraint=false];
}
