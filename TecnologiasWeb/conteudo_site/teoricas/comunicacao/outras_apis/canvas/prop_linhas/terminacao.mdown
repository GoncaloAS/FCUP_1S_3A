## Terminação de linhas ##

<script>
window.base = function(gc) {
  gc.save();

  gc.strokeStyle = "#228";
  gc.fillStyle ="#228";
  gc.fillText("(0,0)",10,10);
  
  gc.beginPath();
  gc.moveTo(20,20);
  gc.lineTo(290,20);

  gc.lineTo(285,15);
  gc.moveTo(290,20);
  gc.lineTo(285,25);
  
  gc.closePath();
  gc.stroke();
  

  gc.beginPath();
  gc.moveTo(20,20);
  gc.lineTo(20,190);

  gc.lineTo(15,185);
  gc.moveTo(20,190);
  gc.lineTo(25,185);	

  gc.closePath();
  gc.stroke();

  gc.strokeStyle = "#228";
  gc.setLineDash([1,3]);
  
  for(var x=40; x<300; x+=20) {
    gc.beginPath();
    gc.moveTo(x+0.5,20.5);
    gc.lineTo(x+0.5,180.5);
    gc.closePath();
    gc.stroke();
  }

  for(var y=40; y<200; y+=20) {
    gc.beginPath();
    gc.moveTo(20.5,y+0.5);
    gc.lineTo(280.5,y+0.5);
    gc.closePath();
    gc.stroke();
  }

  gc.restore();
}
</script>

<script>

window._update = function() {

  var tela = document.getElementById("tela");
  var gc = tela.getContext("2d");

  base(gc);

  gc.setLineDash([]);
  
  gc.strokeStyle = "orange";
  gc.lineWidth = 20;

  gc.beginPath()
  gc.moveTo(40,60);
  gc.lineTo(200,60)
  gc.lineCap = "butt";
  gc.stroke();

  gc.beginPath()
  gc.moveTo(40,100);
  gc.lineTo(200,100)
  gc.lineCap = "round";
  gc.stroke();

  gc.beginPath()
  gc.moveTo(40,140);
  gc.lineTo(200,140)
  gc.lineCap = "square";
  gc.stroke();

}

</script>

<div class="col50p terminal example" style="margin-top: -30px;">
  gc.beginPath()
  gc.moveTo(20,20);
  gc.lineTo(180,20)
  <span class=focus>gc.lineCap = 'butt'</span>;
  gc.stroke();
  ...
  <span class=focus>gc.lineCap = 'round'</span>;
  ...
  <span class=focus>gc.lineCap = 'square'</span>;
</div>
<div markdown=1 class=col50p style="margin-top: -30px;">
<canvas id="tela" width="300" height="200" style="display: block; width: 300px; margin: auto;"></canvas>
</div>

* Propriedade <code class=focus>lineCap</code> - define **terminação** dos segmentos
* Enumeração de valores
     * <code class=focus>butt</code> - cortado <span class=litle>(por omissão)</span>
     * <code class=focus>round</code> - arredondado
     * <code class=focus>square</code> - quadrado

<div class=foot>Também depende da largura de linha</div>