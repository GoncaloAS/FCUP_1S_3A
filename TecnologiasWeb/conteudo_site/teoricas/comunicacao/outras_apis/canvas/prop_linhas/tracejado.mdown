## Propriedades de linhas ##

<script>
window.base = function(gc) {
  gc.save();

  gc.strokeStyle = "#228";
  gc.fillStyle ="#228";
  gc.fillText("(0,0)",10,10);
  
  gc.beginPath();
  gc.moveTo(20,20);
  gc.lineTo(290,20);

  gc.lineTo(285,15);
  gc.moveTo(290,20);
  gc.lineTo(285,25);
  
  gc.closePath();
  gc.stroke();
  

  gc.beginPath();
  gc.moveTo(20,20);
  gc.lineTo(20,190);

  gc.lineTo(15,185);
  gc.moveTo(20,190);
  gc.lineTo(25,185);	

  gc.closePath();
  gc.stroke();

  gc.strokeStyle = "#228";
  gc.setLineDash([1,3]);
  
  for(var x=40; x<300; x+=20) {
    gc.beginPath();
    gc.moveTo(x+0.5,20.5);
    gc.lineTo(x+0.5,180.5);
    gc.closePath();
    gc.stroke();
  }

  for(var y=40; y<200; y+=20) {
    gc.beginPath();
    gc.moveTo(20.5,y+0.5);
    gc.lineTo(280.5,y+0.5);
    gc.closePath();
    gc.stroke();
  }

  gc.restore();
}
</script>

<script>

window._update = function() {

  var tela = document.getElementById("tela");
  var gc = tela.getContext("2d");

  base(gc);

  gc.setLineDash([]);
  gc.strokeStyle = "orange";
  gc.lineWidth = 10;

  gc.beginPath()
  gc.moveTo(30,30);
  gc.lineTo(210,30)
  gc.setLineDash([1,1]);
  gc.stroke();

  gc.beginPath()
  gc.moveTo(30,50);
  gc.lineTo(210,50)
  gc.setLineDash([1,3]);
  gc.stroke();

  gc.beginPath()
  gc.moveTo(30,70);
  gc.lineTo(210,70)
  gc.setLineDash([3,1]);
  gc.stroke();

  gc.beginPath()
  gc.moveTo(30,90);
  gc.lineTo(210,90)
  gc.setLineDash([3,1,3]);
  gc.stroke();

  gc.beginPath()
  gc.moveTo(30,110);
  gc.lineTo(210,110)
  gc.setLineDash([3,2,5,4]);
  gc.stroke();

}

</script>

<div class="col50p terminal example" style="margin-top: -30px;">
  gc.lineWidth = 10;

  gc.beginPath()
  gc.moveTo(30,30);
  gc.lineTo(210,30)
  <span class=focus>gc.setLineDash([1,1])</span>;
  gc.stroke();
  ...
  <span class=focus>gc.setLineDash([1,3])</span>;
  ...
  <span class=focus>gc.setLineDash([3,1])</span>;
    ...
  <span class=focus>gc.setLineDash([3,1,3])</span>;
