## Retângulos como caminhos ##

<script>
window.base = function(gc) {
  gc.save();

  gc.strokeStyle = "#228";
  gc.fillStyle ="#228";
  gc.fillText("(0,0)",10,10);
  
  gc.beginPath();
  gc.moveTo(20,20);
  gc.lineTo(290,20);

  gc.lineTo(285,15);
  gc.moveTo(290,20);
  gc.lineTo(285,25);
  
  gc.closePath();
  gc.stroke();
  

  gc.beginPath();
  gc.moveTo(20,20);
  gc.lineTo(20,190);

  gc.lineTo(15,185);
  gc.moveTo(20,190);
  gc.lineTo(25,185);	

  gc.closePath();
  gc.stroke();

  gc.strokeStyle = "#228";
  gc.setLineDash([1,3]);
  
  for(var x=40; x<300; x+=20) {
    gc.beginPath();
    gc.moveTo(x+0.5,20.5);
    gc.lineTo(x+0.5,180.5);
    gc.closePath();
    gc.stroke();
  }

  for(var y=40; y<200; y+=20) {
    gc.beginPath();
    gc.moveTo(20.5,y+0.5);
    gc.lineTo(280.5,y+0.5);
    gc.closePath();
    gc.stroke();
  }

  gc.restore();
}
</script>

<script>

window._update = function() {

  var tela = document.getElementById("tela");
  var gc = tela.getContext("2d");

  base(gc);

  gc.strokeStyle = "orange";
  gc.fillStyle = "orange";  

  gc.beginPath();
  gc.rect(40,40,100,120);
  gc.stroke();

  gc.beginPath();
  gc.rect(160,40,100,120);
  gc.fill();


}

</script>

<div class="col50p terminal example" style="margin-top: -30px;">

  gc.beginPath();
  <span class=focus>gc.rect(20,20,100,120)</span>;
  gc.stroke();

  gc.beginPath();
  <span class=focus>gc.rect(140,20,100,120)</span>;
  gc.fill();

</div>

<canvas id="tela" width="300" height="200"></canvas>


* Função <code class=focus>rect()</code> cria **caminho** em forma de retângulo
    * **Não** requere um ponto inicial <span class=litle>(ex: `moveTo()`)</span>
    * Precisa do <code class=focus>beginPath()</code> ou liga ao último ponto aberto
* Pode ser usada para
    * **Traçar** retângulos <span class=litle>(com `stroke()`)</span> - como `strokeRect()`
    * **Preencher** retângulos <span class=litle>(com `fill()`)</span> - como `fillRect()`
* Argumentos idênticos a restantes funções de retângulos
