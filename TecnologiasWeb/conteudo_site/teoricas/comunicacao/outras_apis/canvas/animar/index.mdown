## Animações ##

<script>

window._update = function() {

Watch.numberSize = 14;
Watch.largeMarkSize = 10;
Watch.smallMarkSize = 5;

Watch.prototype.base = null;
Watch.prototype.gc = null;
Watch.prototype.center = null;
Watch.prototype.length = undefined;

function Watch(canvasId) {
    this.base = document.getElementById(canvasId);    
    this.gc = this.base.getContext("2d");

    this.center = { x: this.base.width / 2, y: this.base.height / 2 };
    this.length = Math.min(this.center.x,this.center.y);

    this.show();
    setInterval(this.show.bind(this),1000);
}

Watch.prototype.show = function() {
    var gc = this.gc;
    var now = new Date();

    this.base.width = this.base.width;
    
    this.gc.translate(this.center.x,this.center.y);
    this.gc.textAlign = "center";
    this.gc.textBaseline = "middle"; 
    this.gc.font = Watch.numberSize+"pt Arial bold";
    
    this.face(gc);

    gc.strokeStyle = "#228";
    this.hand(gc,now.getHours()+now.getMinutes()/60,12,this.length / 2,3);
    this.hand(gc,now.getMinutes(),60,this.length - Watch.numberSize,2);
    this.hand(gc,now.getSeconds(),60,this.length - Watch.numberSize,1);    

}


Watch.prototype.hand = function(gc,value,max,length,width) {
    var angle = (2*(value % max) / max - 1) * Math.PI;
	
    gc.save();
    gc.rotate(angle);
    gc.moveTo(width/2,0);
    gc.lineTo(0,length);
    gc.lineTo(-width/2,0);
    gc.lineWidth = width;
    gc.stroke();
    gc.restore();
}


Watch.prototype.face = function(gc) {
    gc.strokeStyle = "#228";
    gc.fillStyle = "#228";
    
    for(var minutes = 1; minutes <= 60; minutes++) {
	var angle = minutes*Math.PI/30 - Math.PI/2;
	var isHour = (minutes % 5) == 0;
	var len = this.length-Watch.numberSize-Watch.largeMarkSize;
		
	if(isHour) {
	    let hour = minutes / 5;
	    gc.save()
	    gc.fillStyle = "orange";
	    gc.fillText(hour,len*Math.cos(angle),len*Math.sin(angle));
	    gc.restore();
	}
	
	gc.save();
	gc.rotate(angle);
	gc.moveTo(this.length,0);
	gc.lineTo(this.length -
		  (isHour ? Watch.largeMarkSize : Watch.smallMarkSize),0);
	gc.stroke();
	gc.restore();
    }
}

var watch = new Watch("watch");

WindMill.radialVelocity = Math.PI/100;

WindMill.prototype.base = null;
WindMill.prototype.gc = null;
WindMill.prototype.alpha = 0;
WindMill.prototype.center = null;
WindMill.prototype.length = undefined;

function WindMill(canvasId) {
    this.base = document.getElementById(canvasId);
    this.gc = this.base.getContext("2d");

    this.gc.fillStyle = "orange";
    
    this.center = { x: this.base.width / 2, y: this.base.height / 2 };
    this.length = Math.min(this.center.x,this.center.y);

    this.play();
}

WindMill.prototype.play = function() {
    this.base.width = this.base.width;
    
    this.show(this.gc);

    this.alpha -= WindMill.radialVelocity;
    
    window.requestAnimationFrame(this.play.bind(this));
}


WindMill.prototype.show = function(gc) {
    
    gc.beginPath();
    gc.moveTo(this.center.x,2*this.center.y);
    gc.lineTo(this.center.x,this.center.y);
    gc.strokeStyle = "#228";
    gc.lineWidth = 10;
    gc.stroke();
    
    for(var beta = this.alpha; beta < this.alpha+2*Math.PI; beta += Math.PI/2)
	this.sail(gc,beta);

    this.centerCircle(gc,this.length/5,"#228");
    this.centerCircle(gc,this.length/9,"orange");
    this.centerCircle(gc,this.length/30,"#228");
}

WindMill.prototype.centerCircle = function(gc,length,color) {
    gc.beginPath();
    gc.arc(this.center.x,this.center.y,length,0,2*Math.PI);
    gc.fillStyle = color;
    gc.fill();
}


WindMill.prototype.sail = function(gc,beta) {
    var a = WindMill.inLine(this.center,beta,this.length);
    var b = WindMill.inLine(this.center,beta-Math.PI/2,this.length/2);
    
    var c1 = WindMill.inLine(a,beta-3*Math.PI/4,this.length/2);
    var c2 = WindMill.inLine(b,beta,this.length/2);
    var c3 = WindMill.inLine(this.center,beta-Math.PI/4,this.length/2);
    
    gc.beginPath();
    gc.moveTo(this.center.x,this.center.y);
    gc.lineTo(a.x,a.y);
    gc.bezierCurveTo(c1.x,c1.y,c2.x,c2.y,b.x,b.y);
    gc.closePath();
    gc.fillStyle = "#228";
    gc.fill();

    gc.beginPath();
    gc.moveTo(this.center.x,this.center.y);
    gc.lineTo(a.x,a.y);
    gc.bezierCurveTo(c1.x,c1.y,c3.x,c3.y,this.center.x,this.center.y);
    gc.fillStyle = "orange";
    gc.fill();

}

WindMill.inLine = function(p,a,l) {

    return { x: p.x+l*Math.cos(a), y: p.y+l*Math.sin(a) };
}

var windmill = new WindMill("windmill");


}

</script>

<canvas id="watch" width=400 height=200></canvas>
<canvas id="windmill" width=400 height=200></canvas>

* Animações requerem a execução repetitiva de código JS
* Ciclos infinitos degradariam a experiência de utilização <span class=litle>(UX)</span>
* Podem ser obtidos usando mecanismos de temporização do JS
* Ou requerendo execução de *frames* ao navegador
* Cada *frame* da animação deve ser totalmente redesenhado 