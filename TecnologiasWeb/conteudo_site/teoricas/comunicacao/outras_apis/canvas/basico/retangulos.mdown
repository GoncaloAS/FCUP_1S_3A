## Retângulos ##



<script>

window._update = function() {

  var tela = document.getElementById("tela");
  var gc = tela.getContext("2d");

  gc.strokeStyle = "#228";
  gc.fillStyle ="#228";
  gc.fillText("(0,0)",10,10);
  
  gc.beginPath();
  gc.moveTo(20,20);
  gc.lineTo(290,20);

  gc.lineTo(285,15);
  gc.moveTo(290,20);
  gc.lineTo(285,25);
  
  gc.closePath();
  gc.stroke();
  

  gc.beginPath();
  gc.moveTo(20,20);
  gc.lineTo(20,190);

  gc.lineTo(15,185);
  gc.moveTo(20,190);
  gc.lineTo(25,185);	

  gc.closePath();
  gc.stroke();

  gc.strokeStyle = "#228";
  gc.setLineDash([1,3]);
  
  for(var x=40; x<300; x+=20) {
    gc.beginPath();
    gc.moveTo(x+0.5,20.5);
    gc.lineTo(x+0.5,180.5);
    gc.closePath();
    gc.stroke();
  }

  for(var y=40; y<200; y+=20) {
    gc.beginPath();
    gc.moveTo(20.5,y+0.5);
    gc.lineTo(280.5,y+0.5);
    gc.closePath();
    gc.stroke();
  }

  gc.setLineDash([]);

  gc.strokeStyle = "orange";
  gc.fillStyle ="orange";
  gc.lineWidth = 2;

  gc.strokeRect(40, 40, 100, 40);

  gc.fillRect(40, 100, 100, 40);

  gc.fillRect(160, 40, 100, 100);
  gc.clearRect(180, 60, 60, 60);  
}

</script>

<div class="col50p terminal example" style="margin-top: -30px;">
gc.strokeRect(20, 20, 100, 40);

gc.fillRect(20, 80, 100, 40);

gc.fillRect(140, 20, 100, 100);
gc.clearRect(160, 40, 60, 60);

</div>
<div class=col50p style="margin-top: -30px;">
<canvas id="tela" width="300" height="200" style="display: block; width: 300px; margin: auto;"></canvas>
</div>

* Métodos de criação de retângulos têm argumentos
    * <code class=focus>x</code>
    * <code class=focus>y</code>
    * <code class=focus>width</code>
    * <code class=focus>height</code>
* Podem ser traçados retângulos com
    * <code class=focus>strokeRect()</code> - traçar
    * <code class=focus>fillRect()</code> - preencher
    * <code class=focus>clearRect()</code> - limpar