## Dimensões ##

<script>

window._update = function() {

  const canvas = document.getElementById("tela");
  const gc = tela.getContext("2d");

  gc.strokeStyle = "#228";
  gc.fillStyle ="#228";
  gc.fillText("(0,0)",10,10);
  
  gc.beginPath();
  gc.moveTo(20,20);
  gc.lineTo(290,20);

  gc.lineTo(285,15);
  gc.moveTo(290,20);
  gc.lineTo(285,25);
  
  gc.closePath();
  gc.stroke();
  

  gc.beginPath();
  gc.moveTo(20,20);
  gc.lineTo(20,190);

  gc.lineTo(15,185);
  gc.moveTo(20,190);
  gc.lineTo(25,185);	

  gc.closePath();
  gc.stroke();

  gc.strokeStyle = "#228";
  gc.setLineDash([1,3]);
  
  for(var x=40; x<300; x+=20) {
    gc.beginPath();
    gc.moveTo(x+0.5,20.5);
    gc.lineTo(x+0.5,180.5);
    gc.closePath();
    gc.stroke();
  }

  for(var y=40; y<200; y+=20) {
    gc.beginPath();
    gc.moveTo(20.5,y+0.5);
    gc.lineTo(280.5,y+0.5);
    gc.closePath();
    gc.stroke();
  }

  gc.setLineDash([]);

  gc.strokeStyle = "orange";
  gc.fillStyle ="orange";
  gc.lineWidth = 2;

  var xc = canvas.width/2;
  var yc = canvas.height/2;

  gc.fillRect(xc-20,yc-10,20,20);
}

</script>

<div class="col50p terminal example" style="margin-top: -30px;">

  const xc = <span class=focus>canvas.width</span>/2;
  const yc = <span class=focus>canvas.height</span>/2;

  gc.fillRect(xc-10,yc-10,20,20);


</div>
<div class=col50p style="margin-top: -30px;">
<canvas id="tela" width="300" height="200" style="display: block; width: 300px; margin: auto;"></canvas>
</div>

* Propriedades do canvas refletem dimensões
    * <code class=focus>width</code>
    * <code class=focus>height</code>
* Dimensões devem ser definidas em HTML e **não em CSS**
* Alterar dimensões provoca um *reset* ao `canvas`