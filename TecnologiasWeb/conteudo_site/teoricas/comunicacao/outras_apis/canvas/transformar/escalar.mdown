## Hometetias ##


<script>
window.base = function(gc) {

  gc.save();

  gc.strokeStyle = "#228";
  gc.fillStyle ="#228";
  gc.fillText("(0,0)",10,10);
  
  gc.beginPath();
  gc.moveTo(20,20);
  gc.lineTo(290,20);

  gc.lineTo(285,15);
  gc.moveTo(290,20);
  gc.lineTo(285,25);
  
  gc.closePath();
  gc.stroke();
  

  gc.beginPath();
  gc.moveTo(20,20);
  gc.lineTo(20,190);

  gc.lineTo(15,185);
  gc.moveTo(20,190);
  gc.lineTo(25,185);	

  gc.closePath();
  gc.stroke();

  gc.strokeStyle = "#228";
  gc.setLineDash([1,3]);
  
  for(var x=40; x<300; x+=20) {
    gc.beginPath();
    gc.moveTo(x+0.5,20.5);
    gc.lineTo(x+0.5,180.5);
    gc.closePath();
    gc.stroke();
  }

  for(var y=40; y<200; y+=20) {
    gc.beginPath();
    gc.moveTo(20.5,y+0.5);
    gc.lineTo(280.5,y+0.5);
    gc.closePath();
    gc.stroke();
  }

  gc.restore();

  gc.translate(20,20);

}
</script>

<script>

window._update = function() {

  var tela = document.getElementById("tela");
  var gc = tela.getContext("2d");

  base(gc);

  function sample(text) {
  
      gc.font = "40px Arial";
      gc.textBaseline = "top";
      gc.strokeStyle = "orange";
      gc.fillStyle = "#228";

      var w = gc.measureText(text).width;
      
      gc.fillText(text,0,0); 
      gc.strokeRect(0,0,w,40);
  }

  sample("teste 1");
  gc.translate(0,40);
  gc.scale(2,2);
  sample("teste 2");
  gc.translate(60,-20);
  gc.scale(0.5,0.5);
  sample("teste 3");
  gc.translate(-120,120);
  gc.scale(1,0.5);
  sample("teste 4");
  gc.translate(240,0);
  gc.scale(-0.5,2);
  sample("teste 5");
}
</script>


