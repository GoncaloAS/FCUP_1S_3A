## Características do tipo letra ##


<script>
window.base = function(gc) {
  gc.save();

  gc.strokeStyle = "#228";
  gc.fillStyle ="#228";
  gc.fillText("(0,0)",10,10);
  
  gc.beginPath();
  gc.moveTo(20,20);
  gc.lineTo(290,20);

  gc.lineTo(285,15);
  gc.moveTo(290,20);
  gc.lineTo(285,25);
  
  gc.closePath();
  gc.stroke();
  

  gc.beginPath();
  gc.moveTo(20,20);
  gc.lineTo(20,190);

  gc.lineTo(15,185);
  gc.moveTo(20,190);
  gc.lineTo(25,185);	

  gc.closePath();
  gc.stroke();

  gc.strokeStyle = "#228";
  gc.setLineDash([1,3]);
  
  for(var x=40; x<300; x+=20) {
    gc.beginPath();
    gc.moveTo(x+0.5,20.5);
    gc.lineTo(x+0.5,180.5);
    gc.closePath();
    gc.stroke();
  }

  for(var y=40; y<200; y+=20) {
    gc.beginPath();
    gc.moveTo(20.5,y+0.5);
    gc.lineTo(280.5,y+0.5);
    gc.closePath();
    gc.stroke();
  }

  gc.restore();
}
</script>

<script>

window._update = function() {

  var tela = document.getElementById("tela");
  var gc = tela.getContext("2d");

  base(gc);

  gc.setLineDash([]);
  gc.strokeStyle = "#228";
  gc.fillStyle = "orange";
  gc.lineWidth = 1;

  gc.font = "32pt Arial";
  gc.fillText("the quick",30,60);
  gc.strokeText("brown fox",30,100);
  gc.fillText("jumped over",30,140);
  gc.strokeText("the lazy dog",30,180);  
}

</script>


<div class="col50p terminal example">
gc.strokeStyle = '#228';
gc.fillStyle = 'orange';
gc.lineWidth = 1;
<span class=focus>gc.font = '32pt Arial'</span>;
  
gc.fillText('the quick',10,40);
gc.strokeText('brown fox',10,80);
gc.fillText('jumped over',10,120);
gc.strokeText('the lazy dog',30,160);  
</div>
<div class=col50p>

<canvas id="tela" width="300" height="200" style="display: block; width: 300px; margin: auto;"></canvas>

</div>

* A propriedade <code class=focus>font</code> carateriza  tipo de letra
* Tem a mesma sintaxe da <a href="../../../../cliente/css/propriedades/tipo">propriedade `font` do CSS</a> e inclui
    * `font-style` -  ex: `italic`
    * `font-variant` -  ex: `small-caps`
    * `font-weight` - ex: `bold`
    * `font-size` - ex: `32pt`
    * `font-family` - ex: `Arial`
    