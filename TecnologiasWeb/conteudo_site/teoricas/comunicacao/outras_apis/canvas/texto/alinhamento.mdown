## Alinhamento ##


<script>
window.base = function(gc) {
  gc.save();

  gc.strokeStyle = "#228";
  gc.fillStyle ="#228";
  gc.fillText("(0,0)",10,10);
  
  gc.beginPath();
  gc.moveTo(20,20);
  gc.lineTo(290,20);

  gc.lineTo(285,15);
  gc.moveTo(290,20);
  gc.lineTo(285,25);
  
  gc.closePath();
  gc.stroke();
  

  gc.beginPath();
  gc.moveTo(20,20);
  gc.lineTo(20,190);

  gc.lineTo(15,185);
  gc.moveTo(20,190);
  gc.lineTo(25,185);	

  gc.closePath();
  gc.stroke();

  gc.strokeStyle = "#228";
  gc.setLineDash([1,3]);
  
  for(var x=40; x<300; x+=20) {
    gc.beginPath();
    gc.moveTo(x+0.5,20.5);
    gc.lineTo(x+0.5,180.5);
    gc.closePath();
    gc.stroke();
  }

  for(var y=40; y<200; y+=20) {
    gc.beginPath();
    gc.moveTo(20.5,y+0.5);
    gc.lineTo(280.5,y+0.5);
    gc.closePath();
    gc.stroke();
  }

  gc.restore();
}
</script>

<script>

window._update = function() {

  var tela = document.getElementById("tela");
  var gc = tela.getContext("2d");

  base(gc);

  gc.strokeStyle = "orange";
  gc.lineWidth = 4;
  gc.beginPath();
  gc.moveTo(120,20);
  gc.lineTo(120,180);
  gc.stroke();

  gc.setLineDash([]);
  gc.strokeStyle = "#228";
  gc.fillStyle = "#228";
  gc.lineWidth = 1;

  gc.font = "32pt Arial";


  gc.fillText("the quick",120,60);
  gc.textAlign = "left";
  gc.fillText("brown fox",120,100);
  gc.textAlign = "center";
  gc.fillText("jumped over",120,140);
  gc.textAlign = "right";
  gc.fillText("the lazy dog",120,180);  
}

</script>


<div class="col50p terminal example">
gc.fillText('the quick',100,60);
<span class=focus>gc.textAlign = 'left'</span>;  
gc.strokeText('brown fox',100,100);
<span class=focus>gc.textAlign = 'center'</span>;  
gc.fillText('jumped over',100,140);
<span class=focus>gc.textAlign = 'right'</span>;  
gc.strokeText('the lazy dog',100,180);  
</div>
<div class=col50p>

<canvas id="tela" width="300" height="200" style="display: block; width: 300px; margin: auto;"></canvas>

</div>

* A propriedade <code class=focus>textAlign</code> alinha texto face às coordnadas
* Valores possíveis são
    * `left` - esquerda <span class=litle>(por omissão)</span>
    * `center` - centro
    * `right` - direita
    * `start` - início  do texto <span class=litle>(depende se LTR ou RTL)</span>
    * `end` - fim  do texto <span class=litle>(depende se LTR ou RTL)</span>