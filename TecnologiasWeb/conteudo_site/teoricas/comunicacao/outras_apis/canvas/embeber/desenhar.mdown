<script>

window._update = function() {

const canvas = document.getElementById("tela");
const gc = canvas.getContext("2d");


function lines() {
gc.strokeStyle = "orange";
for(let y=22; y<canvas.height; y+=22) {
  gc.beginPath();
  gc.moveTo(0,y);
  gc.lineTo(canvas.width,y);
  gc.stroke();
}
}

lines();

var start = null;

canvas.onmousedown = function(event) {
  start = relativeCoords(event);
}

canvas.onmousemove = function(event) {

   if(start !== null) {
   var p = relativeCoords(event);
   canvas.width = canvas.width;
   lines();
   gc.fillStyle = "rgba(255,165,0,0.6)";
   gc.fillRect(start.x,(start.y / 20)*19,(p.x-start.x),22);

 }
}

canvas.onmouseup = function(event) {
  start = null;
}

function relativeCoords (event) {
  var bounds = event.target.getBoundingClientRect();
  var x = event.clientX - bounds.left;
  var y = event.clientY - bounds.top;
  return {x: x, y: y};
}

}
</script>

