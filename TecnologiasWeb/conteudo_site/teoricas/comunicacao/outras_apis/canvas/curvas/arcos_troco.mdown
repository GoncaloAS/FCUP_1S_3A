## Segmento em arco ##

<script>

window._update = function() {

  var tela = document.getElementById("tela");
  var gc = tela.getContext("2d");

  gc.strokeStyle = "#228";
  gc.fillStyle ="#228";
  gc.fillText("(0,0)",10,10);
  
  gc.beginPath();
  gc.moveTo(20,20);
  gc.lineTo(290,20);

  gc.lineTo(285,15);
  gc.moveTo(290,20);
  gc.lineTo(285,25);
  
  gc.closePath();
  gc.stroke();
  

  gc.beginPath();
  gc.moveTo(20,20);
  gc.lineTo(20,190);

  gc.lineTo(15,185);
  gc.moveTo(20,190);
  gc.lineTo(25,185);	

  gc.closePath();
  gc.stroke();

  gc.strokeStyle = "#228";
  gc.setLineDash([1,3]);
  
  for(var x=40; x<300; x+=20) {
    gc.beginPath();
    gc.moveTo(x+0.5,20.5);
    gc.lineTo(x+0.5,180.5);
    gc.closePath();
    gc.stroke();
  }

  for(var y=40; y<200; y+=20) {
    gc.beginPath();
    gc.moveTo(20.5,y+0.5);
    gc.lineTo(280.5,y+0.5);
    gc.closePath();
    gc.stroke();
  }

  gc.setLineDash([]);
  gc.lineWidth = 2;

  gc.beginPath();
  gc.moveTo(40,40);
  gc.lineTo(100,40);
  gc.stroke();

  gc.beginPath();
  gc.moveTo(100,40);
  gc.strokeStyle = "orange";
  gc.arcTo(140,40,140,80,40);
  gc.stroke();

  gc.beginPath();
  gc.arc(140,40,3,0,2*Math.PI);
  gc.stroke();

  gc.strokeStyle = "#228";
  gc.lineWidth = 1;
  gc.setLineDash([2,3]);

  gc.beginPath();
  gc.arc(100,80,40,0,2*Math.PI);
  gc.stroke();

  gc.strokeStyle = "orange";
  gc.lineWidth = 2;
  
  gc.beginPath();
  gc.moveTo(100,80);
  gc.lineTo(140,80);
  gc.stroke();


  gc.beginPath();
  gc.moveTo(100,40);
  gc.lineTo(140,40);
  gc.stroke();

  gc.beginPath();
  gc.moveTo(140,80);
  gc.lineTo(140,40);
  gc.closePath();	
  gc.stroke();	

  gc.beginPath();

}

</script>


<div class="col50p terminal example" style="margin-top: -30px;">
  gc.beginPath();
  gc.moveTo(20,20);
  <code class=focus>gc.arcTo(140,20,
           140,140,
           100)</code>;
  gc.stroke();
</div>
<div class=col50p style="margin-top: -30px;">
<canvas id="tela" width="300" height="200" style="display: block; width: 300px; margin: auto;"></canvas>
</div>

* caminhos traçados com <code class=focus>arcTo(xc,yc,x,y,raio)</code>
    * `xc` e `yc` são coordenadas do **ponto de controlo**
    * `x` e `y` são coordenadas do **ponto final**
    * `raio` do circulo cujo arco une os 2 ponto
* Coordenadas do **ponto inicial** são as últimas do caminho
* Curva é **tangente** às retas que passam por
    * Ponto inicial e ponto de controlo 1, no ponto inicial
    * Ponto final e ponto de controlo 2, no ponto final