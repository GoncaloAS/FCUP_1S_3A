## Curvas Bezier ##

<script>

window._update = function() {

  var tela = document.getElementById("tela");
  var gc = tela.getContext("2d");

  gc.strokeStyle = "#228";
  gc.fillStyle ="#228";
  gc.fillText("(0,0)",10,10);
  
  gc.beginPath();
  gc.moveTo(20,20);
  gc.lineTo(290,20);

  gc.lineTo(285,15);
  gc.moveTo(290,20);
  gc.lineTo(285,25);
  
  gc.closePath();
  gc.stroke();
  

  gc.beginPath();
  gc.moveTo(20,20);
  gc.lineTo(20,190);

  gc.lineTo(15,185);
  gc.moveTo(20,190);
  gc.lineTo(25,185);	

  gc.closePath();
  gc.stroke();

  gc.strokeStyle = "#228";
  gc.setLineDash([1,3]);
  
  for(var x=40; x<300; x+=20) {
    gc.beginPath();
    gc.moveTo(x+0.5,20.5);
    gc.lineTo(x+0.5,180.5);
    gc.closePath();
    gc.stroke();
  }

  for(var y=40; y<200; y+=20) {
    gc.beginPath();
    gc.moveTo(20.5,y+0.5);
    gc.lineTo(280.5,y+0.5);
    gc.closePath();
    gc.stroke();
  }

  gc.setLineDash([]);
  gc.strokeStyle = "orange";
  gc.fillStyle = "orange";
  gc.lineWidth = 2;

  gc.beginPath();
  gc.moveTo(40,100);
  gc.bezierCurveTo(200,40,160,120,260,160);
  gc.stroke();

  gc.beginPath();
  gc.arc(200,40,3,0,2*Math.PI);
  gc.closePath();
  gc.fill();

  gc.beginPath();
  gc.arc(160,120,3,0,2*Math.PI);
  gc.closePath();
  gc.fill();

  gc.strokeStyle = "#228";
  gc.lineWidth = 1;
  gc.setLineDash([2,3]);

  gc.beginPath();
  gc.moveTo(40,100);
  gc.lineTo(200,40);
  gc.closePath();	
  gc.stroke();

  gc.beginPath();
  gc.moveTo(260,160);
  gc.lineTo(160,120);
  gc.closePath();	
  gc.stroke();	

}

</script>


<div class="col50p terminal example" style="margin-top: -30px;">

  gc.beginPath();
  gc.moveTo(20,80);
  <span class=focus>gc.bezierCurveTo(180,20,
                   140,100,
                   240,140)</span>;
  gc.stroke();


</div>
<div class=col50p style="margin-top: -30px;">
<canvas id="tela" width="300" height="200" style="display: block; width: 300px; margin: auto;"></canvas>
</div>

* Curvas traçadas com <code class=focus>bezierCurveTo(xc1,yc1,xc2,yc2,x,y)</code>
    * `xc1` e `yc1` são coordenadas do **ponto de controlo 1**
    * `xc2` e `yc2` são coordenadas do **ponto de controlo 2**
    * `x` e `y` são coordenadas do **ponto final**
* Coordenadas do **ponto inicial** são as últimas do caminho
* Curva é **tangente** às retas que passam por
    * Ponto inicial e ponto de controlo 1, no ponto inicial
    * Ponto final e ponto de controlo 2, no ponto final