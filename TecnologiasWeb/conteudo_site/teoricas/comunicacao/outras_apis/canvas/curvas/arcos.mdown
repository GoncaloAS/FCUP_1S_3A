## Arcos completos ##

<script>
window.base = function(gc) {
  gc.save();

  gc.strokeStyle = "#228";
  gc.fillStyle ="#228";
  gc.fillText("(0,0)",10,10);
  
  gc.beginPath();
  gc.moveTo(20,20);
  gc.lineTo(290,20);

  gc.lineTo(285,15);
  gc.moveTo(290,20);
  gc.lineTo(285,25);
  
  gc.closePath();
  gc.stroke();
  

  gc.beginPath();
  gc.moveTo(20,20);
  gc.lineTo(20,190);

  gc.lineTo(15,185);
  gc.moveTo(20,190);
  gc.lineTo(25,185);	

  gc.closePath();
  gc.stroke();

  gc.strokeStyle = "#228";
  gc.setLineDash([1,3]);
  
  for(var x=40; x<300; x+=20) {
    gc.beginPath();
    gc.moveTo(x+0.5,20.5);
    gc.lineTo(x+0.5,180.5);
    gc.closePath();
    gc.stroke();
  }

  for(var y=40; y<200; y+=20) {
    gc.beginPath();
    gc.moveTo(20.5,y+0.5);
    gc.lineTo(280.5,y+0.5);
    gc.closePath();
    gc.stroke();
  }

  gc.restore();
}
</script>

<script>

window._update = function() {

  var tela = document.getElementById("tela");
  var gc = tela.getContext("2d");

  base(gc);

  gc.strokeStyle = "orange";
  gc.fillStyle = "orange";  

  gc.beginPath();
  gc.arc(80,80,40,0,2*Math.PI,true);
  gc.stroke();

  gc.beginPath();
  gc.arc(180,80,40,0,Math.PI,true);
  gc.fill();

  gc.beginPath();
  gc.arc(180,100,40,0,Math.PI,false);
  gc.fill();

}

</script>

<div class="col50p terminal example" style="margin-top: -30px;">gc.beginPath();
<span class=focus>gc.arc(60,60,40,0,2*Math.PI,true)</span>;
gc.stroke();

gc.beginPath();
gc.arc(160,60,40,0,Math.PI,<span class=focus>true</span>);
gc.fill();

gc.beginPath();
gc.arc(160,80,40,0,Math.PI,<span class=focus>false</span>);
gc.fill();
</div>

<canvas id="tela" width="300" height="200"></canvas>


* Função <code class=focus>arc()</code> cria **caminho** em forma de arco
    * **Não** requerem um ponto inicial (ex: `moveTo()`)
    * Precisa do <code class=focus>beginPath()</code> ou liga ao último ponto aberto
* Pode criar
    * Circunferências - <code class=focus>stroke()</code> - ou círculos - <code class=focus>fill()</code>
    * Arcos parciais ou completos <span class=litle>(<code class=focus>2*Math.PI</code>)</span>