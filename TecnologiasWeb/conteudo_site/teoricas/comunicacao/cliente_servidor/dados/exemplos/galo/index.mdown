## Jogo do Galo multiutilizador ##

<script>

window._update = function() {

TicTacToe.prototype.content = new Array(9);
TicTacToe.prototype.board = new Array(9);
TicTacToe.prototype.current = "X";

function TicTacToe(id) {

    var parent = document.getElementById(id);
    var board  = document.createElement("div");

    board.className = "board";
    parent.appendChild(board);

    for(var i=0; i<9; i++) {
	var cell = document.createElement("div");
	cell.className = "cell"+(((i+1) % 3) == 0 ? " line" : "");
	board.appendChild(cell);
	cell.innerHTML = "&nbsp;";

	cell.onclick = function(fun,pos) {
	    return function() { fun(pos); }
	}(this.play.bind(this),i);
	
	this.board[i] = cell;
    }
    
}

TicTacToe.prototype.play = function(pos) {
    this.content[pos] = this.current;
    this.board[pos].innerHTML = this.current;
    
    this.current = (this.current == "X" ? "O" : "X");
}

var ticTacToe = new TicTacToe("base");

}

</script>


