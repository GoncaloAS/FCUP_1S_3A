## Contador ##


<script>

window._update = function() {

Counter.prototype.count = 0;
Counter.prototype.display = undefined;

function Counter(parentId) {

    var parent  = document.getElementById(parentId);
    var counter = document.createElement("div");
    var incr = document.createElement("div");
    var reset = document.createElement("div");
    this.display = document.createElement("div");

    parent.appendChild(counter);
    counter.appendChild(incr);
    counter.appendChild(reset);
    counter.appendChild(this.display);

    counter.className = "counter";
    incr.className = "button";
    reset.className = "button";
    this.display.className = "display";

    incr.innerText = " Incr ";
    reset.innerText = " Reset ";
    this.display.innerText = this.count;
    
    incr.onclick = this.increment.bind(this);
    reset.onclick = this.reset.bind(this);
}

Counter.prototype.increment = function() {
    this.count ++;

    this.display.innerText = this.count;
}

Counter.prototype.reset= function() {
    this.count = 0;

    this.display.innerText = this.count;
}

	var counter = new Counter("base");

}

</script>


