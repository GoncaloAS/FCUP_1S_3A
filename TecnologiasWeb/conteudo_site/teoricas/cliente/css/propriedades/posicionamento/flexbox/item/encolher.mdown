.container {
	   display: flex;
	   width: 100%;
	   height: 80px;
	   background:
	   orange; opacity: .5;
}

.item {
	   /* width: 100px;*/
	   height: 50px;
	   background: #228;
	   color: white;
	   margin: 10px;
	   text-align: center;
	   line-height: 50px;
}

</style>

<div class="terminal example col50p">&lt;div style=flex-base: 100px; &hellip;">1&lt;/div>
&lt;div style=flex-base: 200px; &hellip;">2&lt;/div>
&lt;div style=flex-base: 300px; &hellip;">3&lt;/div>
</div>
<div class="col50p">
	<div class=container>

	     <div class=item style="flex-basis: 100px;"> 1 </div>
	     <div class=item style="flex-basis: 200px;"> 2 </div>
	     <div class=item style="flex-basis: 300px;"> 3 </div>

	</div>
</div>
<div class=ruler></div>
<div class="terminal example col50p">&hellip; flex-shrink: 0; &hellip;
&hellip; flex-shrink: 0; &hellip;
&hellip; flex-shrink: 0; &hellip;
</div>
<div class="col50p">
	<div class=container>

	     <div class=item style="flex-basis: 100px; flex-shrink: 0;"> 1 </div>
	     <div class=item style="flex-basis: 200px; flex-shrink: 0;"> 2 </div>
	     <div class=item style="flex-basis: 300px; flex-shrink: 0;"> 3 </div>

	</div>
</div>
<div class=ruler></div>
<div class="terminal example col50p">&hellip; flex-shrink: 1; &hellip;
&hellip; flex-shrink: 2; &hellip;
&hellip; flex-shrink: 3; &hellip;
</div>
<div class="col50p">
	<div class=container>

	     <div class=item style="flex-basis: 100px; flex-shrink: 1;"> 1 </div>
	     <div class=item style="flex-basis: 200px; flex-shrink: 2;"> 2 </div>
	     <div class=item style="flex-basis: 300px; flex-shrink: 3;"> 3 </div>

	</div>
</div>
<div class=ruler></div>
<div class="terminal example col50p">&hellip; flex-shrink: 3; &hellip;
&hellip; flex-shrink: 2; &hellip;
&hellip; flex-shrink: 1; &hellip;
</div>
<div class="col50p">
	<div class=container>

	     <div class=item style="flex-basis: 0; flex-grow: 3;"> 1 </div>
	     <div class=item style="flex-basis: 0; flex-grow: 2;"> 2 </div>
	     <div class=item style="flex-basis: 0; flex-grow: 1;"> 3 </div>

	</div>
</div>



* Propriedade `flex-shrink` controla o encolhimento dos itens
    * 0 - não há encolhimento, mesmo que extravase contentor
    * 1 - encolhimento base <span class=litle>(omissão)</span>
    * *n* - encolhe *n* vezes mais que *1*