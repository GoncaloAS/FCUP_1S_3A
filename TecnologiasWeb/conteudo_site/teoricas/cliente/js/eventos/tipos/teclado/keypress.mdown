## Tipo `keypress`

<script>

window._update = function() {

   const dot = document.getElementById("dot");


   document.onkeypress = function(event) {
     let left = parseInt(dot.style.left);
     let top = parseInt(dot.style.top);

     switch(event.key) {
        case "k": case "K":
          left += 10;
	  break;
        case "j": case "J":
          left -= 10;
	  break;
        case "i": case "I":
          top -= 10;
	  break;
        case "m": case "m":
          top += 10;
	  break;	  
     }
     dot.style.left = left+"px";
     dot.style.top  = top+"px";

   };
};

</script>

<div class="col75p terminal example" >
   const dot = document.getElementById("dot");

   <span class=focus>document.onkeypress</span> = function(<span class=focus>event</span>) {
