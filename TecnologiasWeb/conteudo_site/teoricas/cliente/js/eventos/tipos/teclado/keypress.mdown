     switch(<span class=focus>event.key</span>) {
        case "k": case "K": left += 10; break;
        case "j": case "J": left -= 10; break;
        case "i": case "I": top -= 10;  break;
        case "m": case "M": top += 10;  break;	  
     }
     dot.style.left = left+"px";
     dot.style.top  = top+"px";
   };
</div>
