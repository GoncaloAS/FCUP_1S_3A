<script>
let conta = 0;

window.conta = function() {
    const base = document.getElementById("base");
    const lista = base.getElementsByTagName("div");

    conta++;

    for(let i = 0; i<lista.length; i++)
       lista.item(i).innerText = conta
}

</script>

