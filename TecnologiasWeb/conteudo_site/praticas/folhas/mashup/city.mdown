<div class="example litle">
<a target=city href="http://api.geonames.org/searchJSON?formatted=true&q=port&username=twlab&style=full">http://api.geonames.org/searchJSON?formatted=true&<span class=focus>q=porto</span>&lang=pt&username=twlab&style=full</a>
</div>

