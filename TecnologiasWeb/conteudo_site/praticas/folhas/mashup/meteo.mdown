O URL acima retorna um JSON semelhante ao seguinte, com as condições meteorológicas do aeroporto do Porto, em Pedras Rubras

<div class="terminal example litle">
{"weatherObservation": {
  "elevation": 73,
  "lng": -8.666666666666666,
  "observation": "LPPR 141130Z 11012KT CAVOK 14/07 Q1025",
  "ICAO": "LPPR",
  "clouds": "clouds and visibility OK",
  "dewPoint": "7",
  "cloudsCode": "CAVOK",
  "datetime": "2021-12-14 11:30:00",
  "countryCode": "PT",
  "temperature": "14",
  "humidity": 62,
  "stationName": "Porto / Pedras Rubras",
  "weatherCondition": "n/a",
  "windDirection": 110,
  "hectoPascAltimeter": 1025,
  "windSpeed": "12",
