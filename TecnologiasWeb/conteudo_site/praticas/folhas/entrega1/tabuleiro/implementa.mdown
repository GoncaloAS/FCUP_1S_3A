<div id="gamePanel" class="col25p cozy" style="transform-origin: -300px 175px; transform: scale(0.85,0.85)"></div>

<script>
window._update = async function() {

fetch("praticas/trabalho/regras/tab_board.js")
  .then(response => response.text())
  .then(src => {
        eval((src));

        const board = new Board({parent: 'gamePanel', size: 5})
		const blue  = { color: 'Blue' };
        const red   = { color: 'Red' };
		const moved = { color: 'Blue', inMotion: true };

        board.state({
            board: [
			     blue,	blue,	blue,	blue,	null,
			     null,  moved,	null,	null,	null,
			     null,	null,	null,	null,	null,
			     red,	red,	red,	red,	red
            ],
        });

   })
  .catch(console.error);

}
</script>

* Modelo de dados
	* Casas: objetos representado peças ou null
	* Tabuleiro: _array_ de casas na ordem sequencial
* Funções/métodos sobre casas e tabuleiro
    * Inicializar tabuleiro
    * Mostrar tabuleiro: gerar elementos usando DOM
	* Reagir à seleção de uma  casa
