digraph prototipos {
  // Cadeia de protótipos de f = new Finalista(...); cada seta é um __proto__
  rankdir=LR;
  nodesep=0.2; ranksep=0.35;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=15,
        fillcolor="#EBF2FA", color="#1B4F72", margin="0.12,0.06"];
  edge [color="#1B4F72", arrowsize=0.8];
  f  [label="f\nnome, curso, anoFinal"];
  Fp [label="Finalista.prototype\nsaudacao()"];
  Ap [label="Aluno.prototype\nsaudacao()"];
  Pp [label="Pessoa.prototype\nsaudacao()"];
  Op [label="Object.prototype\ntoString()...", fillcolor="#F2F3F4", color="#555555"];
  nu [label="null", shape=plaintext, style="", fontsize=15];
  f -> Fp -> Ap -> Pp -> Op -> nu;
}
