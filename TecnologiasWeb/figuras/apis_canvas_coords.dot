digraph CanvasCoords {
  layout=neato;
  fontname="Helvetica";
  node [fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=12];

  canvas [shape=box, pos="1.5,1!", width=3.0, height=2.0, fixedsize=true,
          label="", color="#B9770E", penwidth=2];

  origem [shape=point, width=0.09, pos="0,2!", color="#1B4F72"];
  origemLbl [shape=plaintext, pos="-0.35,2.25!", fontsize=13, label="(0,0)"];

  xend [shape=point, width=0.01, pos="3,2!"];
  yend [shape=point, width=0.01, pos="0,0!"];
  origem -> xend [color="#922B21", penwidth=2.5];
  origem -> yend [color="#1E7A46", penwidth=2.5];
  xLbl [shape=plaintext, pos="2.6,2.25!", fontsize=13, label="X →", fontcolor="#922B21"];
  yLbl [shape=plaintext, pos="-0.35,0.1!", fontsize=13, label="Y ↓", fontcolor="#1E7A46"];

  ponto [shape=point, width=0.09, pos="2,0.5!", color="#1B4F72"];
  pontoLbl [shape=plaintext, pos="2.6,0.5!", fontsize=13, label="(200,150)"];
  guiaX [shape=point, width=0.01, pos="2,2!"];
  guiaY [shape=point, width=0.01, pos="0,0.5!"];
  ponto -> guiaX [dir=none, style=dashed, color="#888888"];
  ponto -> guiaY [dir=none, style=dashed, color="#888888"];

  legenda [shape=plaintext, pos="1.5,-0.3!", fontsize=12, label="canvas de 300×200 px"];
}
