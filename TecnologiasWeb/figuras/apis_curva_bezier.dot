// compilar com: neato -n2 -Tpdf apis_curva_bezier.dot -o apis_curva_bezier.pdf
digraph CurvaBezier {
  // neato -n2: posições em pontos; a curva usa os pontos de controlo reais
  node [fontname="Helvetica", fontsize=11, shape=point, width=0.07, color="#1B4F72", label=""];
  edge [arrowhead=none];
  P0 [pos="40.0,100.0"]; C1 [pos="200.0,160.0"]; C2 [pos="160.0,80.0"]; P1 [pos="260.0,40.0"];
  l0 [shape=plaintext, width=0, pos="40.0,85.0", label="P0 (40,100)"];
  l1 [shape=plaintext, width=0, pos="200.0,172.0", label="C1 (200,40)"];
  l2 [shape=plaintext, width=0, pos="160.0,66.0", label="C2 (160,120)"];
  l3 [shape=plaintext, width=0, pos="260.0,26.0", label="P1 (260,160)"];
  P0 -> C1 [style=dashed, color="#888888", pos="40.0,100.0 40.0,100.0 200.0,160.0 200.0,160.0"];
  P1 -> C2 [style=dashed, color="#888888", pos="260.0,40.0 260.0,40.0 160.0,80.0 160.0,80.0"];
  P0 -> P1 [color="#B9770E", penwidth=2.5, pos="40.0,100.0 200.0,160.0 160.0,80.0 260.0,40.0"];
}
