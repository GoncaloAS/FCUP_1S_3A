digraph GridLinhasColunas {
  layout=neato;
  fontname="Helvetica";
  node [fontname="Helvetica"];

  /* Linhas de grelha (numeradas) ao longo do topo -- fronteiras das colunas */
  c1 [shape=plaintext, pos="0,3.5!", label="linha de coluna 1"];
  c2 [shape=plaintext, pos="1,3.5!", label="2"];
  c3 [shape=plaintext, pos="2,3.5!", label="3"];
  c4 [shape=plaintext, pos="3,3.5!", label="4"];

  /* Linhas de grelha (numeradas) ao longo do lado esquerdo -- fronteiras das linhas */
  r1 [shape=plaintext, pos="-0.9,3!", label="linha de linha 1"];
  r2 [shape=plaintext, pos="-0.5,2!", label="2"];
  r3 [shape=plaintext, pos="-0.5,1!", label="3"];
  r4 [shape=plaintext, pos="-0.5,0!", label="4"];

  /* Células normais (1x1) */
  c11 [shape=box, pos="0.5,2.5!", width=1, height=1, fixedsize=true, style=filled, fillcolor="#EBF2FA", label="1,1"];
  c13 [shape=box, pos="2.5,2.5!", width=1, height=1, fixedsize=true, style=filled, fillcolor="#EBF2FA", label="1,3"];
  c21 [shape=box, pos="0.5,1.5!", width=1, height=1, fixedsize=true, style=filled, fillcolor="#EBF2FA", label="2,1"];
  c31 [shape=box, pos="0.5,0.5!", width=1, height=1, fixedsize=true, style=filled, fillcolor="#EBF2FA", label="3,1"];
  c32 [shape=box, pos="1.5,0.5!", width=1, height=1, fixedsize=true, style=filled, fillcolor="#EBF2FA", label="3,2"];
  c33 [shape=box, pos="2.5,0.5!", width=1, height=1, fixedsize=true, style=filled, fillcolor="#EBF2FA", label="3,3"];
  c12 [shape=box, pos="1.5,2.5!", width=1, height=1, fixedsize=true, style=filled, fillcolor="#EBF2FA", label="1,2"];

  /* Item que expande: grid-row: 2; grid-column: span 2  (ocupa colunas 2-3 na linha 2) */
  spanitem [shape=box, pos="2,1.5!", width=2, height=1, fixedsize=true,
            style=filled, fillcolor="#B9770E", fontcolor=white,
            label="item com\ngrid-column: span 2"];

  legenda [shape=plaintext, pos="1.05,-1!",
    label="Numeros a cinza = linhas de grelha (fronteiras); células a laranja = item expandido por 2 colunas"];
}
