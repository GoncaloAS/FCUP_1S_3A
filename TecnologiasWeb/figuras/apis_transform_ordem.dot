digraph TransformOrdem {
  layout=neato;
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10];

  tituloA [shape=plaintext, pos="1,1.0!", label="A: translate(100,0) depois rotate(90°)"];
  A0 [shape=point, width=0.09, pos="0,0!", color="#1B4F72"];
  A0lbl [shape=plaintext, pos="0,0.35!", label="origem (0,0)"];
  A1 [shape=point, width=0.09, pos="2,0!", color="#1B4F72"];
  A1lbl [shape=plaintext, pos="2,0.35!", label="após translate(100,0)"];
  Af [shape=point, width=0.11, pos="2,-1.0!", color="#B9770E"];
  Aflbl [shape=plaintext, pos="2.9,-1.0!", label="ponto local (50,0) desenhado\naqui acaba em (100,50)"];

  A0 -> A1 [color="#1E7A46", penwidth=2, label="translate(100,0)"];
  A1 -> Af [color="#922B21", penwidth=2, label="rotate(90°)\n+ desenhar (50,0)"];

  tituloB [shape=plaintext, pos="6,1.0!", label="B: rotate(90°) depois translate(100,0)"];
  B0 [shape=point, width=0.09, pos="5,0!", color="#1B4F72"];
  B0lbl [shape=plaintext, pos="5,0.35!", label="origem (0,0)"];
  B1 [shape=point, width=0.09, pos="5,0!", color="#1B4F72"];
  Bf [shape=point, width=0.11, pos="5,-3.0!", color="#B9770E"];
  Bflbl [shape=plaintext, pos="6.1,-3.0!", label="mesmo ponto local (50,0)\nacaba em (0,150)"];

  B0 -> Bf [color="#922B21", penwidth=2,
    label="rotate(90°) muda a orientação dos eixos;\ntranslate(100,0) passa a mover-se\nao longo do novo eixo X (vertical no ecrã)"];

  nota [shape=plaintext, pos="3.5,-4.0!", fontsize=11,
    label="Mesmo ponto local (50,0), mesmas transformações, ordem trocada → resultados diferentes\ncada transformação seguinte atua no referencial já alterado pelas anteriores"];
}
