digraph fases {
  // Fases de um clique no botão: captura (desce), alvo, bubbling (sobe)
  rankdir=TB; nodesep=0.5; ranksep=0.32;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=14,
        fillcolor="#EBF2FA", color="#1B4F72", width=1.6];
  edge [fontname="Helvetica", fontsize=13, penwidth=1.6];
  html; body; outer [label="div#outer"]; inner [label="div#inner"];
  button [label="button (alvo)", fillcolor="#F5B7B1", color="#922B21"];
  html -> body -> outer -> inner -> button [color="#B9770E"];
  button -> inner -> outer -> body -> html [color="#1E7A46"];
  cap [shape=plaintext, style="", fontsize=14, fontcolor="#B9770E", label="1. captura\n(desce)"];
  bub [shape=plaintext, style="", fontsize=14, fontcolor="#1E7A46", label="3. bubbling\n(sobe)"];
  alvo [shape=plaintext, style="", fontsize=14, fontcolor="#922B21", label="2. alvo"];
  {rank=same; cap; body;}
  {rank=same; bub; outer;}
  {rank=same; alvo; button;}
  cap -> body [style=invis]; outer -> bub [style=invis]; alvo -> button [style=invis];
}
