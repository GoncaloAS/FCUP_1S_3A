digraph Fases {
  rankdir=LR; fontname="Helvetica"; nodesep=0.25; ranksep=0.3;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  src [label="texto\nx := 2+3*4", shape=note, fillcolor="#f4f4f4"];
  lex [label="análise\nlexical", fillcolor="#dbe9ff"];
  par [label="análise\nsintática", fillcolor="#fff3c4"];
  sem [label="análise\nsemântica", fillcolor="#eeeeee", fontcolor="#888888"];
  gen [label="geração\nde código", fillcolor="#eeeeee", fontcolor="#888888"];
  out [label="código\nmáquina", shape=note, fillcolor="#eeeeee", fontcolor="#888888"];
  src -> lex;
  lex -> par [label="tokens"];
  par -> sem [label="AST"];
  sem -> gen [label="AST\nverificada", color="#aaaaaa", fontcolor="#888888"];
  gen -> out [color="#aaaaaa"];
  subgraph cluster_tp1 { label="TP1"; fontsize=10; style="dashed"; color="#888888"; lex; par; }
}
