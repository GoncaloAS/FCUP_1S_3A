digraph dfa {
  rankdir=LR;
  node [shape=circle, fontname="Helvetica", fontsize=11, width=0.55, fixedsize=true];
  edge [fontname="Helvetica", fontsize=11];
  start [shape=point];
  S3 [shape=doublecircle];

  start -> S0;
  S0 -> S1 [label="a"];
  S0 -> S2 [label="b"];
  S1 -> S1 [label="a"];
  S1 -> S2 [label="b"];
  S1 -> S3 [label="c"];
  S2 -> S1 [label="a"];
  S2 -> S2 [label="b"];
}
