  s2 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fde2e2"><TR><TD ALIGN="LEFT"><FONT COLOR="#1f4fb4"><B>2</B></FONT></TD></TR><TR><TD ALIGN="LEFT">R → b • R</TD></TR><TR><TD ALIGN="LEFT">R → •</TD></TR><TR><TD ALIGN="LEFT">R → • b R</TD></TR></TABLE>>];
  s3 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT COLOR="#1f4fb4"><B>3</B></FONT></TD></TR><TR><TD ALIGN="LEFT">T&#x27; → T • $</TD></TR></TABLE>>];
  s4 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT COLOR="#1f4fb4"><B>4</B></FONT></TD></TR><TR><TD ALIGN="LEFT">T → R •</TD></TR></TABLE>>];
  s5 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT COLOR="#1f4fb4"><B>5</B></FONT></TD></TR><TR><TD ALIGN="LEFT">T → a T • c</TD></TR></TABLE>>];
  s6 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT COLOR="#1f4fb4"><B>6</B></FONT></TD></TR><TR><TD ALIGN="LEFT">R → b R •</TD></TR></TABLE>>];
  s7 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT COLOR="#1f4fb4"><B>7</B></FONT></TD></TR><TR><TD ALIGN="LEFT">T → a T c •</TD></TR></TABLE>>];
  start -> s0;
  s0 -> s1 [label="a"];
  s0 -> s2 [label="b"];
  s0 -> s3 [label="T"];
  s0 -> s4 [label="R"];
  s1 -> s1 [label="a"];
  s1 -> s2 [label="b"];
  s1 -> s5 [label="T"];
  s1 -> s4 [label="R"];
