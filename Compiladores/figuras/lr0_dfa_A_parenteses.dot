  s1 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT COLOR="#1f4fb4"><B>1</B></FONT></TD></TR><TR><TD ALIGN="LEFT">A → ( • A )</TD></TR><TR><TD ALIGN="LEFT">A → • ( A )</TD></TR><TR><TD ALIGN="LEFT">A → • a</TD></TR></TABLE>>];
  s2 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT COLOR="#1f4fb4"><B>2</B></FONT></TD></TR><TR><TD ALIGN="LEFT">A → a •</TD></TR></TABLE>>];
  s3 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT COLOR="#1f4fb4"><B>3</B></FONT></TD></TR><TR><TD ALIGN="LEFT">A&#x27; → A • $</TD></TR></TABLE>>];
  s4 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT COLOR="#1f4fb4"><B>4</B></FONT></TD></TR><TR><TD ALIGN="LEFT">A → ( A • )</TD></TR></TABLE>>];
  s5 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT COLOR="#1f4fb4"><B>5</B></FONT></TD></TR><TR><TD ALIGN="LEFT">A → ( A ) •</TD></TR></TABLE>>];
  start -> s0;
  s0 -> s1 [label="("];
  s0 -> s2 [label="a"];
