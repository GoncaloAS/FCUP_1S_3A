digraph pipeline {
  rankdir=TB; nodesep=0.15; ranksep=0.35;
  node [shape=box, fontname="Helvetica", fontsize=11, margin="0.1,0.05"];
  edge [fontname="Helvetica", fontsize=10, arrowsize=0.7];

  texto [label="texto do\nprograma", shape=plain];
  lex [label="Análise\nlexical"];
  toks [label="tokens", shape=plain];
  syn [label="Análise\nsintática"];
  ast [label="árvore\nsintática", shape=plain];
  sem [label="Análise\nsemântica"];
  astf [label="AST + tabela\nde símbolos", shape=plain];

  gc [label="Geração de código"];
  ci [label="código intermédio", shape=plain];

  si [label="Seleção de\ninstruções"];
  asm1 [label="assembly\nsimbólico", shape=plain];
  ar [label="Alocação\nde registos"];
  asm2 [label="assembly\nconcreto", shape=plain];
  al [label="Assembler\n& linker"];
  exe [label="código\nexecutável", shape=plain];

  subgraph cluster_front { label="Frontend"; fontname="Helvetica"; style=dashed;
    {rank=same; texto -> lex -> toks -> syn -> ast -> sem -> astf;} }
  {rank=same; gc -> ci;}
  subgraph cluster_back { label="Backend"; fontname="Helvetica"; style=dashed;
    {rank=same; si -> asm1 -> ar -> asm2 -> al -> exe;} }
  astf -> gc;
  ci -> si;
}
