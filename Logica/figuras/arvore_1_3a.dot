digraph G {
  rankdir=TB; node [shape=plaintext, fontname="Helvetica", fontsize=16];
  root [label="→"];
  and1 [label="∧"];
  neg1 [label="¬"];
  neg2 [label="¬"];
  p1 [label="p"];
